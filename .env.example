# Copy to .env.local for local development, and add the same three
# variables in Vercel under Project Settings > Environment Variables.

# Supabase project URL and publishable (anon) key.
# Safe to expose in the browser: the database is protected by row level
# security and only allows SELECT.
VITE_SUPABASE_URL=https://qebhahxvlopomvkbykeb.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_nyEJTsB1-TlPnruw0hM60g_b-e0C7yx

# Mapbox public access token. Starts with "pk."
# Create one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
