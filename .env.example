# Copy to .env.local for local development, and add the same variable in
# Vercel under Project Settings > Environment Variables.

# Mapbox public access token. Starts with "pk."
# Create one at https://account.mapbox.com/access-tokens/
# Without it the app still works; the map panel just shows a notice.
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
